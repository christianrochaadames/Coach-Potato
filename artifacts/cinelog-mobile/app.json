{
  "expo": {
    "name": "CouchPotato",
    "slug": "coach-potato",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "couchpotato",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.couchpotato.ios",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPrivacyAccessedAPITypes": [],
        "UIApplicationShortcutItems": [
          {
            "UIApplicationShortcutItemTitle": "Log Entry",
            "UIApplicationShortcutItemSubtitle": "Log a movie or show",
            "UIApplicationShortcutItemType": "com.couchpotato.ios.logentry",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeAdd"
          },
          {
            "UIApplicationShortcutItemTitle": "My Watchlist",
            "UIApplicationShortcutItemSubtitle": "View your watchlist",
            "UIApplicationShortcutItemType": "com.couchpotato.ios.watchlist",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeBookmark"
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#116149"
      },
      "package": "com.couchpotato.ios",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF3E8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-quick-actions"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc31d5b4-2663-48ac-8ba0-1dc22c618d1f"
      }
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF3E8"
    },
    "owner": "chrisrianrochaadames"
  }
}
