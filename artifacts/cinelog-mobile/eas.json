{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release",
        "image": "sdk-54"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "couch-potato.replit.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6799059190",
        "appleId": "christian.rocha.adames@outlook.com"
      }
    }
  }
}
