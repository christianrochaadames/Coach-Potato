modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/cinelog-mobile: Expo"

[[workflows.workflow]]
name = "artifacts/cinelog-mobile: Expo"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/cinelog-mobile run dev"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["emacsclient-commands", "glib", "nss", "nspr"]

[userenv]

[userenv.shared]
EXPO_PUBLIC_POSTHOG_HOST = "US Cloud"
FACEBOOK_REDIRECT_URI = "https://couch-potato.replit.app/api/facebook/callback"
